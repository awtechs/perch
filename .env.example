# Development only. Replace both placeholders with different random credentials.
ADMIN_PASSWORD=replace-with-a-random-owner-password-at-least-24-characters
CLIENT_TOKEN=replace-with-a-separate-random-client-token-at-least-32-characters
CLIENT_ID=local-development
CLIENT_NAME=Local development client
DATA_DIR=./data
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://127.0.0.1:8787
MAX_CONCURRENCY=4
# Only configure exact trusted reverse-proxy IPs/CIDRs. Do not use '*'.
TRUST_PROXY=
